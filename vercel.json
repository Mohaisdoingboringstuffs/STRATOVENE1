{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "physics-service",
          "format": "url",
          "env": "PHYSICS_SERVICE_URL"
        }
      ]
    },
    "physics-service": {
      "root": "mini-services/physics-service",
      "framework": "flask"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
